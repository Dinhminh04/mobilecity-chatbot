# MobileCity Chatbot - Environment Variables
# Copy file này thành .env và điền thông tin thực tế

# ── Gemini API ──────────────────────────────
GEMINI_API_KEY=

# ── PostgreSQL ──────────────────────────────
POSTGRES_DB=mobilecity_db
POSTGRES_USER=mobilecity
POSTGRES_PASSWORD=mobilecity123

# ── URLs (không cần sửa nếu chạy local) ────
DATABASE_URL=postgresql://mobilecity:mobilecity123@postgres:5432/mobilecity_db
NEXT_PUBLIC_API_URL=http://localhost:8000
