FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    rasa-sdk==3.6.2 \
    websockets==10.4 \
    psycopg2-binary==2.9.9

RUN pip install --no-cache-dir google-genai --no-deps
RUN pip install --no-cache-dir \
    pydantic>=2.9.0 \
    httpx>=0.28.1 \
    requests>=2.28.1 \
    google-auth>=2.48.1 \
    anyio>=4.8.0 \
    distro>=1.7.0 \
    tenacity>=8.2.3 \
    sniffio

COPY actions/ /app/actions/

CMD ["python", "-m", "rasa_sdk", "--actions", "actions", "--port", "5055"]